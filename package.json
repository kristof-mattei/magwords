{
    "name": "rust-seed-with-web",
    "type": "module",
    "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
    "engines": {
        "node": "26.7.0",
        "pnpm": "11.21.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:watch": "vite build --watch",
        "test": "vitest --coverage.enabled=true",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "pnpm run lint --fix",
        "prepare": "husky",
        "preview": "vite preview",
        "format": "prettier --write .",
        "spellcheck": "cspell --no-progress \"**\"",
        "deps:ci": "depcruise --config dependency-cruiser.config.mjs --output-type err front-end/src",
        "deps:graph": "depcruise --config dependency-cruiser.config.mjs --output-type dot front-end/src | dot -T svg > reports/dependency-graph.svg",
        "deps:report": "depcruise --config dependency-cruiser.config.mjs --output-type err-html --output-to reports/dependency-report.html front-end/src"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --report-unused-disable-directives --max-warnings 0 --",
            "depcruise --config dependency-cruiser.config.mjs --include-only ^front-end/src/ --validate --"
        ],
        "*": [
            "prettier --check --ignore-unknown --"
        ]
    },
    "dependencies": {
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "socket.io-client": "4.8.3"
    },
    "devDependencies": {
        "@codecov/vite-plugin": "2.0.1",
        "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
        "@eslint/config-helpers": "0.7.0",
        "@eslint/core": "1.2.1",
        "@eslint/js": "10.0.1",
        "@eslint/markdown": "8.0.3",
        "@rolldown/plugin-babel": "0.2.3",
        "@stylistic/eslint-plugin": "5.10.0",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/dom": "10.4.1",
        "@testing-library/react": "16.3.2",
        "@types/babel__core": "7.20.5",
        "@types/eslint": "9.6.1",
        "@types/node": "26.2.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@typescript-eslint/parser": "8.66.0",
        "@vitejs/plugin-react": "6.0.5",
        "@vitest/coverage-v8": "4.1.10",
        "@vitest/ui": "4.1.10",
        "babel-plugin-react-compiler": "1.0.0",
        "cspell": "10.0.1",
        "dependency-cruiser": "18.1.1",
        "eslint": "catalog:default",
        "eslint-config-love": "154.1.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-node": "0.4.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-better-tailwindcss": "4.7.0",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-n": "18.3.0",
        "eslint-plugin-perfectionist": "5.10.1",
        "eslint-plugin-prettier": "5.5.6",
        "eslint-plugin-promise": "7.3.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hook-form": "0.3.1",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.4",
        "eslint-plugin-unicorn": "73.0.0",
        "eslint-plugin-yml": "3.8.1",
        "husky": "9.1.7",
        "jiti": "2.7.0",
        "jsdom": "30.0.1",
        "lint-staged": "17.3.0",
        "prettier": "3.9.6",
        "prettier-plugin-sh": "0.19.0",
        "prettier-plugin-toml": "2.0.6",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.66.0",
        "vite": "catalog:default",
        "vite-plugin-checker": "0.14.5",
        "vite-plugin-svgr": "5.2.0",
        "vitest": "4.1.10"
    }
}
