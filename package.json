{
    "name": "magwords",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:watch": "vite build --watch",
        "test": "vitest --coverage.enabled=true",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "pnpm run lint --fix",
        "prepare": "husky",
        "preview": "vite preview",
        "format": "prettier --write .",
        "spellcheck": "cspell --no-progress \"**\"",
        "spellcheck:update": ": > project-words.txt && cspell --no-progress --words-only --unique \"**\" | tr '[:upper:]' '[:lower:]' | LC_ALL=en_US.UTF8 sort --unique > project-words.txt",
        "deps:ci": "depcruise --config dependency-cruiser.config.mjs --output-type err front-end/src",
        "deps:graph": "depcruise --config dependency-cruiser.config.mjs --output-type dot front-end/src | dot -T svg > reports/dependency-graph.svg",
        "deps:report": "depcruise --config dependency-cruiser.config.mjs --output-type err-html --output-to reports/dependency-report.html front-end/src"
    },
    "dependencies": {
        "bootstrap": "5.3.8"
    },
    "devDependencies": {
        "@codecov/vite-plugin": "2.0.1",
        "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
        "@eslint/config-helpers": "0.7.0",
        "@eslint/core": "1.2.1",
        "@eslint/js": "10.0.1",
        "@eslint/markdown": "8.0.3",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/eslint": "9.6.1",
        "@types/node": "26.2.0",
        "@typescript-eslint/parser": "8.67.0",
        "@vitest/coverage-v8": "4.1.11",
        "@vitest/ui": "4.1.11",
        "cspell": "10.0.1",
        "dependency-cruiser": "18.2.0",
        "eslint": "catalog:default",
        "eslint-config-love": "155.0.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-node": "0.4.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-n": "18.3.0",
        "eslint-plugin-perfectionist": "5.10.1",
        "eslint-plugin-prettier": "5.5.6",
        "eslint-plugin-promise": "7.3.0",
        "eslint-plugin-unicorn": "73.0.0",
        "eslint-plugin-yml": "3.8.1",
        "husky": "9.1.7",
        "jiti": "2.7.0",
        "jsdom": "30.0.1",
        "lint-staged": "17.3.0",
        "prettier": "3.9.6",
        "prettier-plugin-sh": "0.19.0",
        "prettier-plugin-toml": "2.0.6",
        "sass-embedded": "1.103.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0",
        "vite": "catalog:default",
        "vite-plugin-checker": "0.14.5",
        "vite-plugin-svgr": "5.2.0",
        "vitest": "4.1.11"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --report-unused-disable-directives --max-warnings 0 --no-warn-ignored --",
            "depcruise --config dependency-cruiser.config.mjs --include-only ^front-end/src/ --validate --"
        ],
        "*": [
            "prettier --check --ignore-unknown --"
        ]
    },
    "engines": {
        "node": "26.7.0",
        "pnpm": "11.22.0"
    },
    "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
