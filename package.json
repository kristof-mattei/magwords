{
    "name": "magwords",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:watch": "vite build --watch",
        "test": "vitest --coverage.enabled=true",
        "lint": "oxlint",
        "lint:fix": "pnpm run lint --fix",
        "prepare": "husky",
        "preview": "vite preview",
        "format": "oxfmt",
        "spellcheck": "cspell --no-progress \"**\"",
        "spellcheck:update": ": > project-words.txt && cspell --no-progress --words-only --unique \"**\" | tr '[:upper:]' '[:lower:]' | LC_ALL=en_US.UTF8 sort --unique > project-words.txt",
        "deps:ci": "depcruise --config dependency-cruiser.config.ts --output-type err front-end/src",
        "deps:graph": "depcruise --config dependency-cruiser.config.ts --output-type dot front-end/src | dot -T svg > reports/dependency-graph.svg",
        "deps:report": "depcruise --config dependency-cruiser.config.ts --output-type err-html --output-to reports/dependency-report.html front-end/src"
    },
    "dependencies": {
        "bootstrap": "5.3.8"
    },
    "devDependencies": {
        "@codecov/vite-plugin": "2.0.1",
        "@types/node": "26.6.2",
        "@vitest/coverage-v8": "5.0.1",
        "@vitest/ui": "5.0.1",
        "cspell": "10.3.3",
        "dependency-cruiser": "18.4.0",
        "eslint-plugin-n": "18.3.0",
        "eslint-plugin-perfectionist": "5.12.0",
        "husky": "9.1.7",
        "jsdom": "30.1.1",
        "lint-staged": "17.5.1",
        "oxfmt": "0.70.0",
        "oxlint": "1.85.0",
        "oxlint-tsgolint": "7.0.2002",
        "sass-embedded": "1.104.1",
        "typescript": "6.0.3",
        "vite": "catalog:default",
        "vite-plugin-checker": "0.14.5",
        "vite-plugin-svgr": "5.2.0",
        "vitest": "5.0.1"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "oxlint --no-error-on-unmatched-pattern --",
            "depcruise --config dependency-cruiser.config.ts --include-only ^front-end/src/ --validate --"
        ],
        "*": [
            "oxfmt --check --no-error-on-unmatched-pattern --"
        ]
    },
    "engines": {
        "node": "26.10.0"
    },
    "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
