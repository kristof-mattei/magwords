{
    "name": "magwords",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:watch": "vite build --watch",
        "test": "vitest --coverage.enabled=true",
        "lint": "oxlint",
        "lint:fix": "pnpm run lint --fix",
        "prepare": "husky",
        "preview": "vite preview",
        "format": "oxfmt",
        "spellcheck": "cspell --no-progress \"**\"",
        "spellcheck:update": ": > project-words.txt && cspell --no-progress --words-only --unique \"**\" | tr '[:upper:]' '[:lower:]' | LC_ALL=en_US.UTF8 sort --unique > project-words.txt",
        "deps:ci": "depcruise --config dependency-cruiser.config.ts --output-type err front-end/src",
        "deps:graph": "depcruise --config dependency-cruiser.config.ts --output-type dot front-end/src | dot -T svg > reports/dependency-graph.svg",
        "deps:report": "depcruise --config dependency-cruiser.config.ts --output-type err-html --output-to reports/dependency-report.html front-end/src"
    },
    "dependencies": {
        "bootstrap": "5.3.8"
    },
    "devDependencies": {
        "@codecov/vite-plugin": "2.0.1",
        "@types/node": "26.6.3",
        "@vitest/coverage-v8": "5.0.2",
        "@vitest/ui": "5.0.2",
        "cspell": "10.3.6",
        "dependency-cruiser": "18.4.0",
        "eslint-plugin-n": "18.4.0",
        "eslint-plugin-perfectionist": "5.12.1",
        "husky": "9.1.7",
        "jsdom": "30.1.1",
        "lint-staged": "17.6.0",
        "oxfmt": "0.71.0",
        "oxlint": "1.86.0",
        "oxlint-tsgolint": "7.0.2003",
        "sass-embedded": "1.105.0",
        "typescript": "6.0.3",
        "vite": "catalog:default",
        "vite-plugin-checker": "0.14.5",
        "vite-plugin-svgr": "5.2.0",
        "vitest": "5.0.2"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "oxlint --no-error-on-unmatched-pattern --",
            "depcruise --config dependency-cruiser.config.ts --include-only ^front-end/src/ --validate --"
        ],
        "*": [
            "oxfmt --check --no-error-on-unmatched-pattern --"
        ]
    },
    "engines": {
        "node": "26.10.0"
    },
    "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
